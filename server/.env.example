# Pulse RCM — environment configuration
# Copy this file to ".env" and fill in your values:
#   cp .env.example .env
# The server loads .env automatically on startup (requires the "dotenv" package).
# NEVER commit your real .env to git — it holds secrets.

# ---------------------------------------------------------------------------
# REQUIRED: session signing secret (generate a long random string)
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Email provider for MFA codes (and future transactional email)
#   console — prints emails to the server log (default, for local development)
#   smtp    — sends real email via any SMTP server (Resend, SendGrid, Postmark…)
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=console

# --- SMTP settings (only needed when EMAIL_PROVIDER=smtp) ---
# Resend (recommended — free tier, purpose-built for transactional email):
#   1. Sign up at https://resend.com
#   2. Dashboard → API Keys → Create API Key → copy it (starts with "re_")
#   3. For testing: use SMTP_FROM=onboarding@resend.dev (no domain setup needed,
#      but it can only send to your own account email)
#   4. For production: Dashboard → Domains → Add Domain → add the DNS records
#      Resend shows you, then use SMTP_FROM=noreply@yourdomain.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_YOUR_API_KEY_HERE
SMTP_FROM=onboarding@resend.dev
# SMTP_SECURE=false        # set to "true" only for port 465

# --- Other providers (same fields, different values) ---
# SendGrid:  host=smtp.sendgrid.net, port=587, user=apikey, pass=<SendGrid API key>
# Postmark:  host=smtp.postmarkapp.com, port=587, user=<server token>, pass=<server token>
# Gmail:     host=smtp.gmail.com, port=587, user=<you@gmail.com>, pass=<app password>
#            (needs a Google "App Password", not your regular password)

# ---------------------------------------------------------------------------
# Server port (optional)
# ---------------------------------------------------------------------------
# PORT=4000

# ---------------------------------------------------------------------------
# Stripe billing (subscriptions)
#   1. Create a Stripe account at https://stripe.com, copy your secret key.
#      Use a sk_test_ key while trying it out, sk_live_ when going live.
#   2. Create the products + prices with one command:
#        STRIPE_SECRET_KEY=sk_test_... npm run setup-stripe
#      …then paste the STRIPE_PRICE_* lines it prints below.
#   3. Add a webhook in the Stripe dashboard:
#        URL: https://yourdomain.com/api/billing/webhook
#        Events: checkout.session.completed, customer.subscription.updated,
#                customer.subscription.deleted
#      …then paste the signing secret (whsec_...) below.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
# Public base URL used for Stripe Checkout return links (no trailing slash)
APP_URL=http://localhost:4000
